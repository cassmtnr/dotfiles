# SSH Client Configuration Template
# Copy this to ~/.ssh/config and customize as needed

# UseKeychain is macOS-only. Linux OpenSSH does not just warn on an unknown
# keyword, it terminates, so one Mac-authored line in the machine-local file
# below breaks every ssh call on a server. Declared before the Include so it
# covers what that file contains.
IgnoreUnknown UseKeychain

# Include machine-specific configurations (not tracked in git)
Include ~/.ssh/config.local

# 1Password SSH agent — auto-detect socket per OS (macOS / Linux).
# Which keys are exposed is controlled by ~/.config/1Password/ssh/agent.toml.
# The exec strings carry no nested quotes: OpenSSH before 9.8 does not accept a
# backslash-escaped quote inside a quoted token, and rejects the entire file
# rather than the line. `?` globs the space in "Group Containers", so the shell
# still receives one path — quoting it would stop $HOME expanding, and escaping
# the space behaves differently on either side of 9.8. exec runs under the login
# shell, and zsh prints "no matches found" when that glob misses (every Linux
# box); the brace group sends the shell's own error to /dev/null too.
Match host * exec "{ test -S ~/Library/Group?Containers/2BUA8C4S2C.com.1password/t/agent.sock; } 2>/dev/null"
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Match host * exec "test -S ~/.1password/agent.sock"
    IdentityAgent ~/.1password/agent.sock

# Global defaults
Host *
    # Security
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PubkeyAuthentication yes
    StrictHostKeyChecking ask

    # Performance
    Compression yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive yes

    # Multiplexing for faster connections
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 600

    # Use ssh-agent for key management
    AddKeysToAgent yes

    # 1Password's agent (filtered via agent.toml) decides which key to offer
    IdentitiesOnly no

# Example
# Host myserver
#     HostName server.example.com
#     User myusername
#     Port 22
#     IdentityFile ~/.ssh/id_rsa
#     ForwardAgent yes
